{
 "_comment": "Generated by scripts/export_web_rules.py from masqai/rules and masqai/policy.py. Do not edit.",
 "rules": [
  {
   "name": "pem_private_key",
   "type": "PRIVATE_KEY",
   "source": "-----BEGIN (?<kind>[A-Z0-9 ]*)PRIVATE KEY( BLOCK)?-----(?:[\\s\\S]*?-----END \\k<kind>PRIVATE KEY( BLOCK)?-----|(?:[\\r\\n]|\\\\[rn]|[A-Za-z0-9+/=])*)",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "jwt",
   "type": "JWT",
   "source": "(?<![A-Za-z0-9_-])eyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "openrouter_key",
   "type": "OR_KEY",
   "source": "(?<![A-Za-z0-9_-])sk-or-v1-[A-Za-z0-9]{20,}(?![A-Za-z0-9])",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "anthropic_key",
   "type": "ANTHROPIC_KEY",
   "source": "(?<![A-Za-z0-9_-])sk-ant-[A-Za-z0-9_-]{20,}",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "openai_key",
   "type": "OPENAI_KEY",
   "source": "(?<![A-Za-z0-9_-])sk-(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{20,}",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "aws_access_key_id",
   "type": "AWS_KEY",
   "source": "(?<![A-Za-z0-9_])(?:AKIA|ASIA)[0-9A-Z]{16}(?![0-9A-Z])",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "aws_secret_access_key",
   "type": "AWS_SECRET",
   "source": "aws_?secret_?access_?key\\\\?[\"']?\\s*[:=]\\s*\\\\?[\"']?([A-Za-z0-9/+=]{40})(?![A-Za-z0-9/+=])",
   "flags": "i",
   "group": 1,
   "ignore": []
  },
  {
   "name": "stripe_key",
   "type": "STRIPE_KEY",
   "source": "(?<![A-Za-z0-9_])(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "stripe_webhook_secret",
   "type": "STRIPE_KEY",
   "source": "(?<![A-Za-z0-9_])whsec_[A-Za-z0-9+/=]{16,}",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "google_api_key",
   "type": "GOOGLE_KEY",
   "source": "(?<![A-Za-z0-9_])AIza[0-9A-Za-z_-]{35}(?![0-9A-Za-z_-])",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "slack_token",
   "type": "SLACK_TOKEN",
   "source": "(?<![A-Za-z0-9_])xox[abposr]-[A-Za-z0-9-]{10,}",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "slack_webhook",
   "type": "SLACK_WEBHOOK",
   "source": "https://hooks\\.slack\\.com/services/[A-Za-z0-9/_-]+",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "github_token",
   "type": "GITHUB_TOKEN",
   "source": "(?<![A-Za-z0-9_])(?:gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,})",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "gitlab_token",
   "type": "GITLAB_TOKEN",
   "source": "(?<![A-Za-z0-9_])glpat-[A-Za-z0-9_-]{20,}",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "npm_token",
   "type": "NPM_TOKEN",
   "source": "(?<![A-Za-z0-9_])npm_[A-Za-z0-9]{36}(?![A-Za-z0-9])",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "huggingface_token",
   "type": "HF_TOKEN",
   "source": "(?<![A-Za-z0-9_])hf_[A-Za-z0-9]{30,}",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "pypi_token",
   "type": "PYPI_TOKEN",
   "source": "(?<![A-Za-z0-9_])pypi-AgEI[A-Za-z0-9_-]{50,}",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "digitalocean_token",
   "type": "DO_TOKEN",
   "source": "(?<![A-Za-z0-9_])do[por]_v1_[a-f0-9]{64}(?![a-f0-9])",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "shopify_token",
   "type": "SHOPIFY_TOKEN",
   "source": "(?<![A-Za-z0-9_])shp(?:at|ss|ca|pa)_[a-fA-F0-9]{32}(?![a-fA-F0-9])",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "sendgrid_key",
   "type": "SENDGRID_KEY",
   "source": "(?<![A-Za-z0-9_])SG\\.[A-Za-z0-9_-]{22}\\.[A-Za-z0-9_-]{43}",
   "flags": "",
   "group": 0,
   "ignore": []
  },
  {
   "name": "url_credentials",
   "type": "CREDENTIAL",
   "source": "\\b[a-z][a-z0-9+.-]*://([^\\s:/@'\"<>{}]+:[^\\s/@'\"<>{}]+)@[A-Za-z0-9.-]",
   "flags": "",
   "group": 1,
   "ignore": [
    {
     "source": "[^:]*:(?:pass|password|passwd|pwd|pw|secret|bar|x+|\\*+|changeme)",
     "flags": "i"
    }
   ]
  },
  {
   "name": "connection_string_secret",
   "type": "CREDENTIAL",
   "source": "(?:^|[;\\s\"'])(?:AccountKey|SharedAccessKey|SharedAccessSignature|Password|PWD|Pwd)=([^;\"'\\s(){}\\[\\],]{6,})(?=;|\"|'|\\s|$)",
   "flags": "m",
   "group": 1,
   "ignore": []
  },
  {
   "name": "bearer_token",
   "type": "BEARER_TOKEN",
   "source": "\\bBearer\\s+([A-Za-z0-9._~+/-]{16,}=*)",
   "flags": "",
   "group": 1,
   "ignore": []
  },
  {
   "name": "email",
   "type": "EMAIL",
   "source": "(?<![A-Za-z0-9._%+-])[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)*\\.[A-Za-z]{2,}(?![A-Za-z0-9-])",
   "flags": "",
   "group": 0,
   "ignore": []
  }
 ],
 "keyvalue": {
  "source": "(?<![A-Za-z0-9_.-])(?<key>[A-Za-z0-9_.-]+)\\\\?[\\\"']?[ \\t]*(?:=|:(?!:))(?![=~])[ \\t]*(?:(?<q>\\\\?[\\\"'])(?<value>[^\\\"'\\\\\\r\\n]+)\\k<q>|(?<bare>[^\\s\\\"'`,;{}()\\[\\]<>|\\\\]+))",
