{
  "name": "local-security-models",
  "cases": "all",
  "runs": 3,
  "concurrency": 2,
  "sandbox": "daytona",
  "self_test": false,
  "publish": false,
  "conditions": [
    {"id": "raw", "kind": "raw", "untrusted": "google/gemini-3.8-flash"},
    {"id": "qwen4b", "kind": "masqai", "untrusted": "google/gemini-3.8-flash",
     "security": {"provider": "ollama-local", "model": "qwen3.5:4b", "think": false}},
    {"id": "nemotron", "kind": "masqai", "untrusted": "google/gemini-3.8-flash",
     "security": {"provider": "ollama-local", "model": "nemotron-3.5-lightning:30b"}}
  ],
  "gateway": {
    "upstream_timeout_seconds": 300,
    "providers": [
      {"name": "ollama-local", "base_url": "http://127.0.0.1:11434", "format": "openai"},
      {"name": "openrouter-security", "base_url": "https://openrouter.ai/api", "api_key_env": "OPENROUTER_API_KEY", "format": "openai"}
    ],
    "pass_unknown": false,
    "security": {
      "api_format": "openai",
      "allow_remote_security_model": false,
      "context_mode": "recent",
      "recent_items": 12,
      "nearest_ops": -1,
      "op_context_lines": 2,
      "auto_mask": "auto_veto",
      "tool_rejection": "rewrite",
      "timeout_s": 600
    },
    "detectors": {"detect_host_identifiers": false, "custom_values": [], "rules_dir": "masqai/rules"},
    "headers": {"mode": "blocklist", "user_agent": "masqai/0.2.0"},
    "retention": {"idle_ttl_h": 12, "max_sessions": 200}
  },
  "agent": {"max_turns": 12, "command_timeout_s": 120, "run_timeout_s": 900, "max_tokens": 2048, "stream": false},
  "relay": {"port": 8788, "upstream": "https://openrouter.ai/api", "key_env": "OPENROUTER_API_KEY", "max_records": 5000}
}
