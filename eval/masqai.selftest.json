{
  "host": "127.0.0.1",
  "port": 8787,
  "upstream_timeout_seconds": 300,
  "providers": [
    {
      "name": "relay",
      "base_url": "http://127.0.0.1:8788",
      "format": "openai"
    },
    {
      "name": "fake-security",
      "base_url": "http://127.0.0.1:8797",
      "format": "openai"
    }
  ],
  "routes": {},
  "default_route": {
    "provider": "relay",
    "model": null
  },
  "pass_unknown": false,
  "security": {
    "enabled": true,
    "provider": "fake-security",
    "model": "fake-security",
