  "detectors": {
    "detect_host_identifiers": false,
    "custom_values": [],
    "rules_dir": "masqai/rules"
  },
  "headers": {
    "mode": "blocklist",
    "user_agent": "masqai/0.2.0"
  },
  "retention": {
    "idle_ttl_h": 12,
    "max_sessions": 50
  }
